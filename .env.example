# 平台模型凭证：本地规则模式可全部留空。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_MODE=auto_safe
DEEPSEEK_MODEL_PREFERENCE=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_MODEL_CACHE_SECONDS=1800
DEEPSEEK_MODEL_STALE_SECONDS=86400
DEEPSEEK_MAX_OUTPUT_TOKENS=1500
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0

# 紧急停止平台AI的总开关；关闭后本地规则模式仍可使用。
SYSTEM_AI_ENABLED=true

# 费用单价按每百万Token填写；多个供应商必须统一换算成同一币种。
# 不确定时保持0，Dashboard仍会记录真实Token，但不生成费用估算。

# 本地开发默认使用 SQLite；运行时目录不会提交到 Git。
COURSE2CAREER_DATABASE_PATH=instance/course2career.db

# URL-safe Base64 编码的 32 字节随机值，仅在开发者 API Key 功能启用时需要。
COURSE2CAREER_KEY_ENCRYPTION_KEY=

# 可选：首次启动时创建唯一的所有者管理员。ADMIN_PASSWORD 与
# ADMIN_PASSWORD_HASH 只能填写一个；生产环境优先使用预生成的哈希。
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=change_me
ADMIN_PASSWORD_HASH=
